<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BirdPhotoSelector</AssemblyName>
    <RootNamespace>BirdPhotoSelector</RootNamespace>
    <Version>2.0.0-alpha.5</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).tools/packages</RestorePackagesPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;Tests/**;publish/**;artifacts/**;docs/**;src/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="src/BirdPhotoSelector.Imaging.Windows/BirdPhotoSelector.Imaging.Windows.csproj" />
    <ProjectReference Include="src/BirdPhotoSelector.Application/BirdPhotoSelector.Application.csproj" />
    <Resource Include="Assets/App.ico" />
    <ProjectReference Include="src/BirdPhotoSelector.Imaging.Portable/BirdPhotoSelector.Imaging.Portable.csproj" />
    <ProjectReference Include="src/BirdPhotoSelector.Platform/BirdPhotoSelector.Platform.csproj" />
    <ProjectReference Include="src/BirdPhotoSelector.Catalog/BirdPhotoSelector.Catalog.csproj" />
    <None Update="models/yolov10n.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="models/bioclip2/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="使用说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="远程兼容启动.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="licenses/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include=".tools/raw-decoder/BirdPhotoSelector.Raw.dll" Link="BirdPhotoSelector.Raw.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include=".tools/raw-decoder/BirdPhotoSelector.Platform.Native.dll" Link="BirdPhotoSelector.Platform.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include=".tools/raw-decoder/libraw.dll" Link="libraw.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include=".tools/raw-decoder/msvcp140.dll;.tools/raw-decoder/vcruntime140.dll;.tools/raw-decoder/vcruntime140_1.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildRawDecoder" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/scripts/Build-RawDecoder.ps1&quot;" />
  </Target>
</Project>
