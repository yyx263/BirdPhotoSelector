<UserControl x:Class="BirdPhotoSelector.Controls.DualPhotoViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="180" Foreground="#E4EBF0" SnapsToDevicePixels="True" UseLayoutRounding="True"
             PreviewKeyDown="Viewer_PreviewKeyDown" IsEnabledChanged="Viewer_IsEnabledChanged">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#141B22" BorderBrush="#2B3640" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="37" />
        </Grid.RowDefinitions>
        <Grid Margin="14,0">
          <TextBlock Text="全图" VerticalAlignment="Center" FontWeight="SemiBold" />
          <TextBlock Text="适应画面" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11" Foreground="#7F929F" />
        </Grid>
        <Border x:Name="FullViewport" Grid.Row="1" Background="#0D1217" ClipToBounds="True"
                SizeChanged="Viewport_SizeChanged">
          <Grid>
            <Image x:Name="FullImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <Canvas x:Name="FullOverlay" IsHitTestVisible="False" ClipToBounds="True">
              <Rectangle x:Name="ViewportOutline" Stroke="#66000000" StrokeThickness="4" Visibility="Collapsed" />
              <Rectangle x:Name="ViewportRectangle" Stroke="White" StrokeThickness="1.5"
                         Fill="#06FFFFFF" Visibility="Collapsed" />
            </Canvas>
            <Canvas x:Name="BirdOverlay" ClipToBounds="True" UseLayoutRounding="False" SnapsToDevicePixels="False" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
              <TextBlock Text="◉" FontSize="34" Foreground="#536975" HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyTitle" Text="等待照片" FontSize="15" Foreground="#9CAFB9" Margin="0,10,0,0"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyMessage" Text="从左上角导入 JPG 照片" FontSize="11" Foreground="#617682"
                         Margin="0,7,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="ImageSizeText" Grid.Row="2" Margin="14,0" VerticalAlignment="Center"
                   Foreground="#7F929F" FontSize="11" Text="白框显示细节预览的位置" />
      </Grid>
    </Border>

    <Border Grid.Column="2" Background="#141B22" BorderBrush="#2B3640" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="37" />
        </Grid.RowDefinitions>
        <Grid Margin="14,0">
          <TextBlock Text="细节预览" VerticalAlignment="Center" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ToggleButton x:Name="ManualRegionButton" Content="手动选区" IsEnabled="False" FontSize="11"
                          Padding="8,4" Margin="0,0,8,0" Click="ManualRegionButton_Click"
                          ToolTip="框选遗漏的鸟，松开鼠标后识别此选区；Esc 取消">
              <ToggleButton.Style><Style TargetType="ToggleButton">
                <Setter Property="Background" Value="#243139"/><Setter Property="Foreground" Value="#C1CFD8"/>
                <Setter Property="BorderBrush" Value="#3C5058"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="ManualButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#345A4D"/><Setter Property="Foreground" Value="#D5F2E5"/><Setter Property="BorderBrush" Value="#9DDFC4"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#91C5B7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ManualButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ToggleButton.Style>
            </ToggleButton>
          <Border Background="#263A37" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
            <TextBlock x:Name="ZoomText" Text="—" FontSize="11" Foreground="#A9E1CD"
                       ToolTip="原始像素显示比例：最小适应画面，最大 200%；小图最多放大至 200%" />
          </Border>
          </StackPanel>
        </Grid>
        <Border x:Name="DetailViewport" Grid.Row="1" Background="#0D1217" ClipToBounds="True" Focusable="True"
                SizeChanged="Viewport_SizeChanged" PreviewMouseWheel="DetailViewport_MouseWheel"
                MouseLeftButtonDown="DetailViewport_MouseLeftButtonDown"
                MouseLeftButtonUp="DetailViewport_MouseLeftButtonUp"
                MouseMove="DetailViewport_MouseMove" LostMouseCapture="DetailViewport_LostMouseCapture">
          <Grid>
            <Canvas x:Name="DetailCanvas" ClipToBounds="True" UseLayoutRounding="False" SnapsToDevicePixels="False">
              <Image x:Name="DetailImage" Stretch="Fill" IsHitTestVisible="False"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Canvas>
            <Canvas x:Name="ManualRegionOverlay" IsHitTestVisible="False" ClipToBounds="True"
                    UseLayoutRounding="False" SnapsToDevicePixels="False">
              <Rectangle x:Name="ManualRegionRectangle" Stroke="#B4EBD5" StrokeThickness="1.5"
                         StrokeDashArray="4,2" Fill="#249DDFC4" Visibility="Collapsed"/>
            </Canvas>
            <StackPanel x:Name="DetailEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
              <TextBlock Text="＋" FontSize="34" Foreground="#536975" HorizontalAlignment="Center" />
              <TextBlock Text="看清羽毛与眼神" FontSize="13" Foreground="#7F929F" HorizontalAlignment="Center"
                         Margin="0,10,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="12,0,6,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="DetectionText" VerticalAlignment="Center" FontSize="11" Foreground="#7F929F"
                     Text="适应画面至 200%" TextTrimming="CharacterEllipsis"
                     ToolTip="滚轮缩放（适应画面至 200%）· 按住左键拖拽；还原鸟类视图以 70% 占比为目标，并遵循缩放范围" />
          <Button x:Name="FitButton" Grid.Column="1" Content="适应画面" Margin="6,3,0,3"
                  Padding="7,4" FontSize="11" Background="#243139" Foreground="#C1CFD8"
                  IsEnabled="False" Click="FitButton_Click" ToolTip="居中显示完整照片，最高放大至 200%" />
          <Button x:Name="RestoreButton" Grid.Column="2" Content="还原鸟类视图" Margin="6,3,0,3"
                  Padding="7,4" FontSize="11" Background="#23322F" Foreground="#ACDDCA"
                  IsEnabled="False" Click="RestoreButton_Click" ToolTip="重新居中到鸟类，以整只鸟占预览框约 70% 为目标；缩放范围为适应画面至 200%" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
