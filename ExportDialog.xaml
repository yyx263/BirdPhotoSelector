<Window Style="{StaticResource {x:Type Window}}" x:Class="BirdPhotoSelector.ExportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="导出 / 清理照片" Width="660" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="27,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="让好照片留下来" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="复制原始 JPG / RAW，不重新压缩，不修改 EXIF。" Foreground="#8C9BA9" Margin="0,6,0,14"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*" MinWidth="400"/></Grid.ColumnDefinitions><TextBlock Text="评级范围" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ActionChoice" MinHeight="42" FontSize="14" SelectedIndex="0" SelectionChanged="ActionChoice_SelectionChanged"><ComboBoxItem Content="导出保留 + 精选"/><ComboBoxItem Content="导出精选"/><ComboBoxItem Content="导出舍弃"/><ComboBoxItem Content="删除舍弃的原文件"/></ComboBox></Grid>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="文件范围" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="FileScopeChoice" MinHeight="40" SelectedIndex="0" SelectionChanged="ActionChoice_SelectionChanged"><ComboBoxItem Content="全部（JPG + RAW）"/><ComboBoxItem Content="仅 JPG"/><ComboBoxItem Content="仅 RAW"/></ComboBox></Grid>
    <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="CountText" Foreground="#9DDFC4" Margin="0,0,0,8"/><StackPanel x:Name="DestinationPanel"><CheckBox x:Name="GroupBySpeciesBox" Content="按鸟种分类导出（多种鸟分别复制整张原件）" IsChecked="False" Checked="Grouping_Changed" Unchecked="Grouping_Changed" Margin="0,0,0,8"/><DockPanel Height="36"><Button DockPanel.Dock="Right" Content="选择目录" Click="Browse_Click" Margin="10,0,0,0"/><TextBox x:Name="DestinationBox" IsReadOnly="True" Background="#11181E" Foreground="#DCE6EC" BorderBrush="#34434F" Padding="9" VerticalContentAlignment="Center" TextChanged="DestinationBox_TextChanged"/></DockPanel><TextBlock x:Name="FolderHint" TextWrapping="Wrap" Text="直接复制到所选现有目录；同名且内容相同跳过，否则询问覆盖或重命名。" Foreground="#8C9BA9" FontSize="11" Margin="0,6,0,10"/><CheckBox x:Name="RemoveOriginalBox" Content="所选文件复制并校验成功后，移除对应原件" IsChecked="False"/></StackPanel><TextBlock x:Name="DeleteWarning" Text="只删除所选文件范围；剩余关联文件和照片评级保留。&#x0a;原文件放入回收站；不支持回收站时永久删除。" Foreground="#E6A098" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="取消" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ConfirmButton" Content="开始导出" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>

