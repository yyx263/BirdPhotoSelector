# These model resources are verified byte-for-byte by asset-hashes.json.
# The pinned generated JSON uses CRLF; upstream license text uses LF.
/models/bioclip2/*.json text eol=crlf
/models/bioclip2/licenses/*.txt text eol=lf
# Preserve the upstream EML's mixed line endings and all vector bytes exactly.
/models/bioclip2/licenses/*.xml -text whitespace=cr-at-eol
/models/bioclip2/*.f32 binary

# Keep the pinned OpenCC dictionary byte-for-byte identical on every host.
/Assets/OpenCC/*.txt text eol=lf

# Preserve upstream license bytes, including their original whitespace.
/licenses/SkiaSharp*.txt -text whitespace=-blank-at-eol,-blank-at-eof
/licenses/OpenCC-Apache-2.0.txt -text whitespace=-blank-at-eof

/licenses/Avalonia-*.txt -text whitespace=-blank-at-eol,-blank-at-eof
/licenses/HarfBuzzSharp*.txt -text whitespace=-blank-at-eol,-blank-at-eof
/licenses/MicroCom-MIT.txt -text
/licenses/TmdsDBus-MIT.txt -text
/licenses/DotNetRuntime-*.txt -text whitespace=-blank-at-eol,-blank-at-eof
/licenses/WindowsDesktopRuntime-LICENSE.txt -text whitespace=-blank-at-eol,-blank-at-eof
