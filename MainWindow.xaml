<Window Style="{StaticResource {x:Type Window}}" x:Class="BirdPhotoSelector.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BirdPhotoSelector" xmlns:controls="clr-namespace:BirdPhotoSelector.Controls" Title="{Binding WindowTitle}" Width="1560" Height="960" MinWidth="1160" MinHeight="760" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Window.Resources>
    <local:RatingGlyphConverter x:Key="RatingGlyph"/><local:RatingColorConverter x:Key="RatingColor"/>
    <local:RatingEqualsConverter x:Key="RatingEquals"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <DataTemplate x:Key="PhotoTemplate">
      <StackPanel>
        <Border Background="#12181F" CornerRadius="4" Height="85">
          <Border.ContextMenu>
            <ContextMenu Tag="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
              <MenuItem x:Name="PhotoRatingUnmarkedMenu" Header="○ 未标记" Tag="Unmarked" Click="PhotoRatingMenu_Click"/>
              <MenuItem x:Name="PhotoRatingRejectMenu" Header="× 舍弃" Tag="Reject" Click="PhotoRatingMenu_Click"/>
              <MenuItem x:Name="PhotoRatingKeepMenu" Header="✓ 保留" Tag="Keep" Click="PhotoRatingMenu_Click"/>
              <MenuItem x:Name="PhotoRatingFavoriteMenu" Header="★ 精选" Tag="Favorite" Click="PhotoRatingMenu_Click"/>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid>
            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
            <Border Background="#E91C252D" CornerRadius="10" Width="23" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
              <TextBlock Text="{Binding Rating,Converter={StaticResource RatingGlyph}}" Foreground="{Binding Rating,Converter={StaticResource RatingColor}}" FontSize="17" FontWeight="Bold" TextAlignment="Center"/>
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="{Binding FileName}" FontSize="11" Margin="1,7,0,1" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
    <Border Background="#181F27" BorderBrush="#2B3540" BorderThickness="0,0,0,1" Padding="22,0"><DockPanel LastChildFill="True">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"><Border Background="#9DDFC4" CornerRadius="11" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="羽" Foreground="#163D30" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="羽选" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="BIRD PHOTO SELECTOR" FontSize="9" Foreground="#8C9BA9" Margin="0,3,0,0"/></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}"><Button Content="添加照片" Style="{StaticResource PrimaryButton}" Click="AddPhotos_Click" ToolTip="选择 JPG / RAW 照片 · Ctrl+O；可关闭“同时读取 RAW”" Margin="0,0,10,0"/><Button x:Name="ClearListButton" Content="清空列表" Click="ClearList_Click" IsEnabled="{Binding HasPhotos}" ToolTip="从当前工程列表移除全部照片，保留磁盘原文件" Margin="0,0,10,0"/><Button Content="打开工程" Click="OpenProject_Click" Margin="0,0,8,0"/><Button Content="保存工程" Click="SaveProject_Click" Margin="0,0,20,0"/><Button Content="恢复自动保存" Click="RecoverAutoSave_Click" Margin="0,0,10,0" ToolTip="打开未命名工程或原路径不可写时生成的自动保存恢复文件"/><Button Content="导出 / 清理" Click="Export_Click" Background="#344940"/><Button Content="?" Click="Help_Click" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Row="1" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="本次挑选" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding LibrarySummary}" Foreground="#8C9BA9" Margin="16,0,0,0" VerticalAlignment="Center"/><CheckBox x:Name="IncludeRawCheckBox" Content="同时读取 RAW" IsChecked="{Binding IncludeRaw}" IsEnabled="{Binding CanEdit}" Margin="18,0,0,0" VerticalAlignment="Center" ToolTip="默认读取 JPG 和 RAW；同目录同名文件合为一张，优先显示 JPG。关闭后仅按原规则导入 JPG。"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="背景相似阈值" Foreground="#AAB7C3" VerticalAlignment="Center"/>
        <Slider x:Name="GroupingThresholdSlider" Width="100" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Threshold}" Margin="12,0,8,0" VerticalAlignment="Center" ToolTip="越高越严格；新版 50% 相当于旧版 95%，只合并导入顺序中连续且背景相似的照片"/>
        <TextBlock Text="{Binding Threshold,StringFormat={}{0:P0}}" Width="43" VerticalAlignment="Center" Foreground="#9DDFC4"/>
        <Button Content="自动分组" Click="Analyze_Click" Padding="15,8" Margin="0,0,8,0" ToolTip="只合并连续相似背景，保留每张照片已有的鸟框、鸟种和视图"/>
        <Button x:Name="RecognizeSpeciesButton" Content="识别鸟种" Click="RecognizeSpecies_Click" Padding="15,8" Background="#344940" ToolTip="逐张定位鸟并识别鸟种，默认限定中国鸟种候选；无需先分组，不改变现有分组"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="14,0,14,10"><Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="150"/><ColumnDefinition Width="6"/><ColumnDefinition Width="148" MinWidth="125"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="580"/></Grid.ColumnDefinitions>
      <Border Background="#181F27" CornerRadius="10" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="3,3,3,10"><TextBlock Text="照片组" FontWeight="SemiBold"/><TextBlock Text="{Binding GroupPosition}" Foreground="#8C9BA9" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="Page Up / Down 切换组" FontSize="10" Foreground="#6F8292" Margin="3,0,0,10"/></StackPanel><StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEdit}"><Button Content="拆分整组" Click="SplitGroup_Click" Style="{StaticResource QuietButton}" Margin="0,8,0,6" ToolTip="将当前组所有照片还原为独立照片"/><Button Content="从列表中移除" Click="RemoveGroups_Click" Style="{StaticResource QuietButton}" ToolTip="仅从列表移除所选组，不删除原文件；Ctrl / Shift 可多选"/></StackPanel>
      <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding CurrentGroup,Mode=TwoWay}" SelectionMode="Extended" IsEnabled="{Binding CanEdit}" PreviewMouseWheel="ThumbnailList_PreviewMouseWheel">
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
          <Border Background="#11171D" Height="94" CornerRadius="4" ContextMenuOpening="GroupRatingMenu_Opening">
            <Border.ContextMenu>
              <ContextMenu Tag="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                <MenuItem x:Name="GroupRatingUnmarkedMenu" Header="○ 未标记" Tag="Unmarked" Click="GroupRatingMenu_Click"/>
                <MenuItem x:Name="GroupRatingRejectMenu" Header="× 舍弃" Tag="Reject" Click="GroupRatingMenu_Click"/>
                <MenuItem x:Name="GroupRatingKeepMenu" Header="✓ 保留" Tag="Keep" Click="GroupRatingMenu_Click"/>
                <MenuItem x:Name="GroupRatingFavoriteMenu" Header="★ 精选" Tag="Favorite" Click="GroupRatingMenu_Click"/>
              </ContextMenu>
            </Border.ContextMenu>
            <Grid><Image Source="{Binding Cover.Thumbnail}" Stretch="Uniform"/>
              <Border Background="#E91C252D" CornerRadius="10" Width="23" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
                <TextBlock Text="{Binding Rating,Converter={StaticResource RatingGlyph}}" Foreground="{Binding Rating,Converter={StaticResource RatingColor}}" FontSize="17" FontWeight="Bold" TextAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="{Binding Title}" FontSize="11" Margin="1,8,0,3" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#8FA599"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox></DockPanel></Border>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
      <Border Grid.Column="2" Background="#181F27" CornerRadius="10" Padding="9"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="3,3,3,10"><TextBlock Text="组内照片" FontWeight="SemiBold"/><TextBlock Text="{Binding PhotoPosition}" Foreground="#8C9BA9" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="方向键 / WASD 切换照片" FontSize="10" Foreground="#6F8292" Margin="3,0,0,10" TextWrapping="Wrap" ToolTip="按方向键或 WASD 连续切换照片，到组边界时继续切换到相邻组；Page Up / Down 直接切换组。"/></StackPanel><StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding CanEdit}"><Button Content="将当前图独立" Click="SplitPhoto_Click" Style="{StaticResource QuietButton}" Margin="0,8,0,6"/><Button Content="从列表中移除" Click="RemovePhotos_Click" Style="{StaticResource QuietButton}" ToolTip="仅从列表移除所选照片，不删除原文件；Ctrl / Shift 可多选"/></StackPanel><ListBox x:Name="PhotoList" ItemsSource="{Binding CurrentGroup.Photos}" SelectedItem="{Binding CurrentPhoto,Mode=TwoWay}" SelectionMode="Extended" ItemTemplate="{StaticResource PhotoTemplate}" IsEnabled="{Binding CanEdit}" PreviewMouseWheel="ThumbnailList_PreviewMouseWheel"/></DockPanel></Border>
      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="Transparent"/>
      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="47"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="78"/></Grid.RowDefinitions>
        <Border Background="#181F27" CornerRadius="10,10,0,0" Padding="17,0"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CurrentPhoto.FileName,TargetNullValue=照片预览}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="GeometryNoticeText" Text="{Binding GeometryNotice}" Foreground="#E7BD83" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="PreviewSourceText" Grid.Column="1" Text="{Binding PreviewSourceLabel}" FontSize="10" Foreground="#98B7AB" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
        <controls:DualPhotoViewer x:Name="Viewer" Grid.Row="1" IsEnabled="{Binding CanEdit}"/>
        <Border Grid.Row="2" Background="#181F27" BorderThickness="0,1,0,0" BorderBrush="#2B3540" TextElement.FontSize="13">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="14,7,14,5" ToolTip="原始 EXIF 拍摄参数">
            <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <DockPanel Margin="0,0,12,0"><TextBlock Text="时间  " Foreground="#899BAA"/><TextBlock x:Name="MetadataCapturedAt" Text="{Binding CurrentPhoto.Metadata.CapturedAt,TargetNullValue=—}"/></DockPanel>
              <DockPanel Grid.Column="1"><TextBlock Text="相机  " Foreground="#899BAA"/><TextBlock x:Name="MetadataCamera" Text="{Binding CurrentPhoto.Metadata.Camera,TargetNullValue=—}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPhoto.Metadata.Camera}"/></DockPanel>
              <DockPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="格式  " Foreground="#899BAA"/><TextBlock x:Name="MetadataFormat" Text="{Binding CurrentFormatLabel}" ToolTip="{Binding CurrentFormatLabel}" Foreground="#B8D6C9"/></DockPanel>
            </Grid>
            <UniformGrid Columns="5">
              <DockPanel Margin="0,0,8,0"><TextBlock Text="焦距  " Foreground="#899BAA"/><TextBlock x:Name="MetadataFocalLength" Text="{Binding CurrentPhoto.Metadata.FocalLength,TargetNullValue=—}" TextTrimming="CharacterEllipsis"/></DockPanel>
              <DockPanel Margin="0,0,8,0"><TextBlock Text="光圈  " Foreground="#899BAA"/><TextBlock x:Name="MetadataAperture" Text="{Binding CurrentPhoto.Metadata.Aperture,TargetNullValue=—}"/></DockPanel>
              <DockPanel Margin="0,0,8,0"><TextBlock Text="快门  " Foreground="#899BAA"/><TextBlock x:Name="MetadataShutter" Text="{Binding CurrentPhoto.Metadata.Shutter,TargetNullValue=—}" TextTrimming="CharacterEllipsis"/></DockPanel>
              <DockPanel Margin="0,0,8,0"><TextBlock Text="ISO  " Foreground="#899BAA"/><TextBlock x:Name="MetadataIso" Text="{Binding CurrentPhoto.Metadata.Iso,TargetNullValue=—}"/></DockPanel>
              <DockPanel><TextBlock Text="补偿  " Foreground="#899BAA"/><TextBlock x:Name="MetadataExposureBias" Text="{Binding CurrentPhoto.Metadata.ExposureBias,TargetNullValue=—}" TextTrimming="CharacterEllipsis"/></DockPanel>
            </UniformGrid>
            </StackPanel>
            <Grid Grid.Row="1" Margin="12,0,12,8">
              <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel VerticalAlignment="Center" Margin="2,0,3,3">
                <TextBlock DockPanel.Dock="Right" Text="识别置信度" Foreground="#8FA79D" FontSize="11" ToolTip="根据首选与其他中国候选的分数差距计算；相近候选越多，置信度越低。这是候选内的相对判断，不代表实际准确率。"/>
                <Button x:Name="ReidentifyCurrentPhotoButton" DockPanel.Dock="Right" Content="重新识别本张" Click="ReidentifyCurrentPhoto_Click" IsEnabled="{Binding CanReidentifyCurrentPhoto}" Style="{StaticResource QuietButton}" Padding="8,2" FontSize="11" Margin="10,0,12,0" ToolTip="仅重新定位和识别当前照片；成功后替换全部自动框和手动选区，失败或取消保留原结果"/>
                <TextBlock Text="鸟种识别" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Text="中国候选 · BioCLIP 2" Foreground="#839A91" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <ListBox x:Name="SpeciesResultsList" Grid.Row="1" ItemsSource="{Binding CurrentPhoto.Birds}" SelectedIndex="{Binding CurrentPhoto.SelectedBirdIndex,Mode=OneWay}"
                       SelectionChanged="SpeciesResults_SelectionChanged" PreviewMouseWheel="SpeciesResults_PreviewMouseWheel" IsEnabled="{Binding CanRate}" Background="#151D24" SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ResultBorder" Background="#1D2930" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="7,4">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ResultBorder" Property="Background" Value="#2A3D3C"/><Setter TargetName="ResultBorder" Property="BorderBrush" Value="#7DAF9F"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResultBorder" Property="BorderBrush" Value="#57716F"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid ToolTip="{Binding RecognitionStatus}" ContextMenuOpening="BirdResultMenu_Opening">
                    <Grid.ContextMenu><ContextMenu>
                      <MenuItem Header="删除选区" Click="DeleteBirdRegionMenu_Click"/>
                    </ContextMenu></Grid.ContextMenu>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number,StringFormat={}{0:00}}" Foreground="#9DDFC4" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SpeciesName}" ToolTip="{Binding SpeciesName}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ScientificName}" ToolTip="{Binding ScientificName}" FontSize="11" Foreground="#879DA7" FontStyle="Italic" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ConfidenceText}" ToolTip="{Binding EvidenceTooltip}" HorizontalAlignment="Right" Foreground="#B8D6C9"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="1" Text="点击“识别鸟种”自动定位并识别鸟" Foreground="#738994" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPhoto.Birds.Count,TargetNullValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="3" Background="#1D2730" CornerRadius="0,0,10,10" Padding="16,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="为这张照片评级" FontWeight="SemiBold"/><TextBlock Text="快捷键 1 / 2 / 3 / 4" FontSize="10" Foreground="#81929F" Margin="0,4,0,0"/></StackPanel>
            <UniformGrid Columns="4" VerticalAlignment="Center" IsEnabled="{Binding CanRate}">
              <RadioButton x:Name="RatingUnmarked" GroupName="PhotoRating" Tag="Unmarked" Style="{StaticResource PhotoRatingButton}" Margin="0,0,7,0" ToolTip="未标记 · 1" IsChecked="{Binding CurrentRating,Mode=TwoWay,Converter={StaticResource RatingEquals},ConverterParameter=Unmarked}"><StackPanel Orientation="Horizontal"><TextBlock Text="○" FontSize="20" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="未标记" VerticalAlignment="Center"/></StackPanel></RadioButton>
              <RadioButton x:Name="RatingReject" GroupName="PhotoRating" Tag="Reject" Style="{StaticResource PhotoRatingButton}" Margin="0,0,7,0" ToolTip="舍弃 · 2" IsChecked="{Binding CurrentRating,Mode=TwoWay,Converter={StaticResource RatingEquals},ConverterParameter=Reject}"><StackPanel Orientation="Horizontal"><TextBlock Text="×" FontSize="20" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="舍弃" VerticalAlignment="Center"/></StackPanel></RadioButton>
              <RadioButton x:Name="RatingKeep" GroupName="PhotoRating" Tag="Keep" Style="{StaticResource PhotoRatingButton}" Margin="0,0,7,0" ToolTip="保留 · 3" IsChecked="{Binding CurrentRating,Mode=TwoWay,Converter={StaticResource RatingEquals},ConverterParameter=Keep}"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="20" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="保留" VerticalAlignment="Center"/></StackPanel></RadioButton>
              <RadioButton x:Name="RatingFavorite" GroupName="PhotoRating" Tag="Favorite" Style="{StaticResource PhotoRatingButton}" ToolTip="精选 · 4" IsChecked="{Binding CurrentRating,Mode=TwoWay,Converter={StaticResource RatingEquals},ConverterParameter=Favorite}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="20" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="精选" VerticalAlignment="Center"/></StackPanel></RadioButton>
            </UniformGrid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#181F27" BorderBrush="#29343F" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel VerticalAlignment="Center"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ProgressBar Width="130" Height="4" Value="{Binding Progress}" Maximum="100" Margin="0,0,12,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Foreground="#9DDFC4"/><Button Content="取消" Click="Cancel_Click" Padding="10,3" Margin="0,0,14,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding AutoSaveSummary}" ToolTip="{Binding AutoSavePath}" Foreground="#7F948E" FontSize="10" Margin="0,0,16,0" VerticalAlignment="Center"/><TextBlock Text="{Binding RatingSummary}" Foreground="#8FA29E" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="OperationStatusText" Text="{Binding Status}" ToolTip="{Binding Status}" Foreground="#8C9BA9" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
</Window>





