<Window x:Class="BirdPhotoSelector.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="羽选 · 使用帮助"
        Width="840" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="使用帮助" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="HelpText" TextWrapping="Wrap" LineHeight="23" Margin="0,0,12,0"/>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Margin="16,0,0,0"/>
      <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
        <Run Text="GitHub："/><Hyperlink x:Name="RepositoryLink" NavigateUri="https://github.com/yyx263/BirdPhotoSelector"
            Foreground="#9DDFC4" RequestNavigate="Repository_RequestNavigate"><Run Text="https://github.com/yyx263/BirdPhotoSelector"/></Hyperlink>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
