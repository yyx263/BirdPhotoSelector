<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultItemExcludes>$(DefaultItemExcludes);Imaging.Core/**;Application.Core/**;PortableAdapters/**;Desktop/**</DefaultItemExcludes>
    <NuGetAudit>false</NuGetAudit>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../.tools/packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BirdPhotoSelector.csproj" />
  </ItemGroup>
</Project>
