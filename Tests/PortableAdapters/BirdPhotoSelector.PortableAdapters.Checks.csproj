<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit><RestorePackagesPath>$(MSBuildThisFileDirectory)../../.tools/packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BirdPhotoSelector.Imaging.Portable/BirdPhotoSelector.Imaging.Portable.csproj" />
    <ProjectReference Include="../../src/BirdPhotoSelector.Platform/BirdPhotoSelector.Platform.csproj" />
    <ProjectReference Include="../../src/BirdPhotoSelector.Catalog/BirdPhotoSelector.Catalog.csproj" />
    <Compile Include="../SpeciesSearchChecks.cs" Link="Shared/SpeciesSearchChecks.cs" />
    <Compile Include="../RawExposureBiasChecks.cs" Link="Shared/RawExposureBiasChecks.cs" />
    <None Include="../../.tools/raw-decoder/*.dll;../../.tools/raw-decoder/*.so*;../../.tools/raw-decoder/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
